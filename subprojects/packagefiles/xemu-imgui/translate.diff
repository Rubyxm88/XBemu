+// xemu: the translation of a format string, or the format itself
+static inline const char* ImTranslateFmt(const char* fmt)
+{
+    if (!GImGuiTranslate || GImGuiTranslateOff > 0)
+        return fmt;
+    const char* end = NULL;
+    const char* t = GImGuiTranslate(fmt, NULL, &end);
+    return t ? t : fmt;
+}
