+// xemu: translation of drawn text. The app sets GImGuiTranslate; it returns
+// the translation of [text, text_end) (text_end may be NULL) with *out_end
+// set, or NULL to keep the text. Text is swapped where fonts draw and measure
+// it, so labels keep their English IDs. GImGuiTranslateOff > 0 turns it off
+// (text the user types).
+typedef const char* (*ImGuiTranslateFn)(const char* text, const char* text_end, const char** out_end);
+extern IMGUI_API ImGuiTranslateFn GImGuiTranslate;
+extern IMGUI_API int GImGuiTranslateOff;
+
