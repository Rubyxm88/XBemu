+ImGuiTranslateFn GImGuiTranslate = NULL;
+int GImGuiTranslateOff = 0;
+
+// xemu: the translation of a piece of text, or the text itself
+static inline void ImTranslateText(const char** text_begin, const char** text_end)
+{
+    if (!GImGuiTranslate || GImGuiTranslateOff > 0 || *text_begin == *text_end)
+        return;
+    const char* end = NULL;
+    const char* t = GImGuiTranslate(*text_begin, *text_end, &end);
+    if (t)
+    {
+        *text_begin = t;
+        *text_end = end;
+    }
+}
+
 ImVec2 ImFont::CalcTextSizeA(float size, float max_width, float wrap_width, const char* text_begin, const char* text_end, const char** remaining)
 {
+    // xemu: a caller that wants a position inside the text gets the text as given
+    if (!remaining)
+        ImTranslateText(&text_begin, &text_end);
     if (!text_end)
         text_end = text_begin + strlen(text_begin); // FIXME-OPT: Need to avoid this.
 
